# syntax=docker/dockerfile:1.7
FROM node:22.23-alpine AS builder

WORKDIR /app

ARG VITE_API_URL=http://localhost:8001/v1
ENV VITE_API_URL=${VITE_API_URL}

COPY package*.json ./
RUN npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm ci

COPY . .
RUN npm run build

FROM node:22.23-alpine

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./

EXPOSE 5173

# Use preview to serve the production build (verifies build artifacts)
# Note: The original dev server is used for faster iteration; this production
# build mode catches build-time issues like missing env vars, asset hashing, etc.
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
